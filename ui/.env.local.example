# Copy to ui/.env.local (gitignored) and fill in. These same four names are the
# environment variables the deployed app needs — set them in the host's project
# settings (see DEPLOY.md), never in a committed file.
#
# None of these carries the NEXT_PUBLIC_ prefix, and none may. That prefix is
# what tells Next.js to inline a value into the client bundle — the *_API_KEY
# values are bearer credentials, read only in src/lib/coreApi.js /
# src/lib/coreWrite.js / src/lib/blnkApi.js, which run server-side behind the
# proxy routes and never reach the browser.

CORE_API_URL=https://jynsipdvrgqdkeqrlzcv.functions.supabase.co/api

# The DEMO_API_KEY value from the repo-root .env.local
CORE_API_KEY=

# The Blnk ledger, for the accounting / general-ledger views. Same proxy
# pattern as the core (read-only, key stays server-side). From the repo-root
# .env.local.
BLNK_API_URL=
BLNK_API_KEY=
