# Python venvs, wherever they are. Deliberately NOT anchored: this was
# `supabase/generate/.venv/`, and moving supabase/ under core/ silently stopped it
# matching — 598 vendored site-packages files staged themselves into the move commit
# before anyone noticed. An anchored ignore is a rule with an expiry date.
.venv/
# supabase CLI scratch
core/supabase/.temp/

# macOS noise; and the Supabase CLI's link-state dir at the repo root
# (created by `db push --linked` runs — the real project lives at core/supabase/)
.DS_Store
/supabase/

# Node deps (the architecture explorer E2E harness)
node_modules/
