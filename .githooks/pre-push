#!/usr/bin/env bash
# Documentation gate, enforced BEFORE every push (a few seconds, no network).
#
#   1. STATE.md must be current  — gen_state.py --check re-derives the live
#      numbers from the working tree + artifacts and diffs against the file.
#   2. Hand-written docs must not lie — check_doc_claims.py verifies every
#      path they reference exists and every gated number matches the
#      artifacts.
#   3. The architecture explorer must not lie — check_architecture.py checks
#      the hand-traced slice's source fingerprints, and gen_architecture.py
#      --check confirms the generated inventory matches the tree.
#
# If this fails: run ./scripts/rebuild_artifacts.sh, commit what changed,
# push again. Never bypass with --no-verify and then not run the cascade —
# CI (doc-gate.yml) runs the same checks on every push and will go red.
#
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

python3 scripts/gen_state.py --check
python3 scripts/check_doc_claims.py
python3 scripts/check_architecture.py
# The inventory reads the spec, so it needs PyYAML; CI (doc-gate.yml) always runs it.
if python3 -c "import yaml" 2>/dev/null; then
  python3 scripts/gen_architecture.py --check
else
  echo "pre-push: PyYAML missing, skipped gen_architecture.py --check (doc-gate.yml runs it)"
fi
